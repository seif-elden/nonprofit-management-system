@startuml 02-strategy
!include style.iuml
title Strategy Pattern - Payment, Notification Channel and Impact Evaluation
!include model.iuml
remove *
restore PaymentStrategy
restore OnlinePayment
restore CheckPayment
restore CashPayment
restore MonetaryDonation
restore DonationController
restore NotificationStrategy
restore EmailStrategy
restore SmsStrategy
restore SocialMediaStrategy
restore NotificationService
restore Channel
restore Message
restore ImpactEvaluationStrategy
restore FoodAidImpactStrategy
restore EducationImpactStrategy
restore ImpactEvaluator
